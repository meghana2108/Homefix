# Absolute path to the unzipped practice pack (contains items.json). NEVER inside the repo.
PRACTICE_PACK_DIR=/absolute/path/to/practice_pack
# full (M4 16 GB) | lite (M2 8 GB)
PROFILE=full
OLLAMA_HOST=http://127.0.0.1:11434
# Runtime must be offline once models are pulled
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# lite profile only: keep one LLM in memory
OLLAMA_MAX_LOADED_MODELS=1
